{
  "name": "hdrezka-desktop",
  "version": "0.0.38",
  "description": "HDREZKA Desktop — Unofficial Windows Client",
  "main": "dist/main/main.js",
  "author": "HDRezka Desktop Team",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/dev.js",
    "build:renderer": "vite build",
    "build:main": "node scripts/build-electron.js",
    "build": "npm run build:renderer && npm run build:main",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder --win",
    "test": "node --test tests/**/*.test.js"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "clsx": "^2.1.1",
    "hls.js": "^1.5.18",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sql.js": "^1.12.0",
    "tailwind-merge": "^3.0.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.25.0",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  },
  "build": {
    "appId": "com.hdrezka.desktop",
    "productName": "HDREZKA Desktop",
    "copyright": "Copyright © 2026",
    "directories": {
      "output": "release"
    },
    "publish": {
      "provider": "github",
      "owner": "KDGOfficial",
      "repo": "HDRezka-Desktop"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "HDREZKA Desktop",
      "artifactName": "HDREZKA-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "HDREZKA-Portable-${version}.${ext}"
    }
  }
}
