{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HDREZKA",
  "version": "1.0.0",
  "identifier": "com.hdrezka.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node test-build.js",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "HDREZKA Desktop",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "decorations": false,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self' tauri: asset:; img-src 'self' asset: https: http: data: blob:; media-src 'self' asset: https: http: blob: data:; connect-src 'self' ipc: tauri: asset: https: http:; script-src 'self' 'unsafe-eval' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https:; font-src 'self' https: data:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "HDRezka Desktop",
    "copyright": "Copyright © 2026 HDRezka Desktop",
    "category": "Entertainment",
    "shortDescription": "HDRezka Windows Desktop Client",
    "longDescription": "Полноценное неофициальное приложение HDREZKA для Windows 10 и 11 для комфортного просмотра фильмов, сериалов, мультфильмов и аниме.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    }
  }
}
